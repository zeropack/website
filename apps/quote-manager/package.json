{
  "name": "zero-pack-quote-builder",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "build:monday": "VITE_APP_MODE=monday npm run check",
    "test:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0",
    "monday-sdk-js": "^0.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
